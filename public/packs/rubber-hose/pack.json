      "maxLength": 30
    },
    {
      "key": "line2",
      "type": "text",
      "label": "Anlatım 2 (kahraman)",
      "labelEn": "Narration 2 (hero)",
      "default": "Kahramanımız uyanmaya hiç niyetli değil.",
      "maxLength": 50
    },
    {
      "key": "line3",
      "type": "text",
      "label": "Anlatım 3 (düşman)",
      "labelEn": "Narration 3 (antagonist)",
      "default": "Ama çalar saatin başka planları var!",
      "maxLength": 45
    }
  ],
  "beats": [
    {
      "atSec": 0.3,
      "label": "Window-shade title card bounces on the beat",
      "say": "line1",
      "maxSec": 1.4
    },
    {
      "atSec": 2.3,
      "label": "The shade rolls up on the bedroom: the hero snores, the alarm clock hops on every beat",
      "sfx": "cartoon snore, old projector clatter"
    },
    {
      "atSec": 3.2,
      "label": "Introducing the hero",
      "say": "line2",
      "maxSec": 3.2
    },
    {
      "atSec": 6.5,
      "label": "Introducing the antagonist; the clock rings on the band's downbeat",
      "say": "line3",
      "maxSec": 2.4,
      "sfx": "vintage alarm clock bell ringing"
    },
    {
      "atSec": 9,
      "label": "The noodle arm swats; the clock dodges; the arm stretches up the wall; dodges again",
      "sfx": "slide whistle up and down, cartoon boing, bonk"
    },
    {
      "atSec": 12.5,
      "label": "The hero sits up defeated, nightcap in hand",
      "sfx": "sad trombone wah-wah"
    },
    {
      "atSec": 13.93,
      "label": "Iris out to the end card on the band's last note"
    }
  ],
